/* Bố cục: sân khấu 16:9 cỡ 1600x900; sợi chỉ chạy dọc đáy là thanh tiến độ, nối cả bài từ khung dệt đến AI. */
:root{
  color-scheme:light;
  /* Mặc định: Giấy kỹ thuật. Nền giấy kẻ ô, mực xanh cobalt, nhấn cam: dễ đọc khi phòng sáng. */
  --cham:#F2F4F0; --cham-2:#E2E6DF; --cham-3:#BEC6BC; --cham-deep:#FFFFFF;
  --vai:#141E2B; --vai-2:#3F4B57; --vai-3:#667380;
  --son:#1F4FD8; --nghe:#C2480F; --si:#0B7A6E;
  --on-son:#FFFFFF; --on-nghe:#FFFFFF; --on-si:#FFFFFF; --on-vai:#FFFFFF;
  --tex:rgba(31,79,216,.06); --ghost:rgba(20,30,43,.09);
  --display:"Bricolage Grotesque","Be Vietnam Pro","Segoe UI",sans-serif;
  --body:"Be Vietnam Pro","Segoe UI",Arial,sans-serif;
  --mono:"IBM Plex Mono","Consolas",monospace;
}
:root[data-look="reu"]{color-scheme:dark;--cham:#10271F;--cham-2:#1A3A2F;--cham-3:#2F5A4A;--cham-deep:#0A1B15;--vai:#F1EFE3;--vai-2:#C2CFC3;--vai-3:#93A89B;--son:#FF8A5B;--nghe:#F2C14E;--si:#7BE0B5;--on-son:#0A1B15;--on-nghe:#0A1B15;--on-si:#0A1B15;--on-vai:#0A1B15;--tex:rgba(255,255,255,.022);--ghost:rgba(241,239,227,.1)}
:root[data-look="cham"]{color-scheme:dark;--cham:#17205E;--cham-2:#222E7E;--cham-3:#33409A;--cham-deep:#0D133D;--vai:#F5F1E6;--vai-2:#C6C8E4;--vai-3:#9DA2CF;--son:#FF5C86;--nghe:#FFC93C;--si:#4BE3C4;--on-son:#0D133D;--on-nghe:#0D133D;--on-si:#0D133D;--on-vai:#0D133D;--tex:rgba(255,255,255,.022);--ghost:rgba(245,241,230,.1)}
