const ERD=[
 ['game_db','8 bảng · Game.Api',[
   [['Level','PK level_id'],['Puzzle','FK level_id'],['GameSession','FK puzzle_id'],['GameMove','FK session_id']]
  ],['GameMode','TaskDefinition','GameAuditLog','OutboxMessage']],
 ['user_db','5 bảng · User.Api',[
   [['UserAccount','PK id · UQ firebase_uid'],['EloHistory','FK user_id']]
  ],['AuditLog','OutboxMessage','InboxMessage']],
 ['multiplayer_db','5 bảng · Multiplayer.Api',[
   [['Match','PK id'],['MatchPlayer','FK match_id']],
   [['Match','PK id'],['MatchMove','FK match_id']]
  ],['PlayerRating · PK (user_id, play_format)','OutboxMessage']],
 ['support_db','7 bảng · Support.Api',[
   [['FeedbackTicket','PK id'],['FeedbackMessage','FK ticket_id']]
  ],['Notification','PlayerRef','Tutorial','SystemNotice','SupportAuditLog']]
];
function SlideErd(){
  return h(Shell,{n:6,eb:'MỤC 2.1 · SƠ ĐỒ THỰC THỂ (ERD)',
    title:h('span',null,'Bốn kho dữ liệu, ',h('em',null,'hai mươi hai'),' thực thể')},
    div({className:'erd r',style:{'--i':2}},...ERD.map(([db,meta,chains,extra],i)=>
      div({className:'erd-card',key:i},
        div({className:'erd-head'},h('b',null,db),span(null,meta)),
        div({className:'erd-body'},...chains.map((chain,ci)=>
          div({className:'erd-chain',key:ci},...chain.flatMap(([ent,key],ei)=>
            [ei?span({className:'erd-rel',key:'r'+ei},span(null,'1—n')):null,
             div({className:'erd-ent',key:'e'+ei},h('b',null,ent),span(null,key))].filter(Boolean))))),
        div({className:'erd-more'},span(null,'Bảng phụ'),...extra.map((x,xi)=>h('i',{key:xi},x)))))),
    h(Strip,{k:'Xuyên database'},'UserId, PuzzleId và MatchId chỉ là tham chiếu mềm: đồng bộ qua gRPC và sudoku.events, không có khoá ngoại vật lý giữa bốn database.'));
}

