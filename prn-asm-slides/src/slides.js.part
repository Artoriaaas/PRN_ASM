/* ---------------- 17 · quyết định ---------------- */
function SlideDecisions(){
  const dec=[
    ['01','Contract-first','.proto là nguồn chân lý cho API và event; C# lẫn TypeScript đều sinh từ đó nên không lệch kiểu.',
      ['Sửa hợp đồng trước, sinh mã sau','Một .proto dùng cho cả client và server'],
      ['game.proto','protoc','C# + TS'],
      'proto/sudoku/*/v1/*.proto',
      'Sửa .proto là phải sinh lại mã ở cả hai phía; bù lại client và server không thể lệch kiểu.'],
    ['02','Outbox + Inbox','Sự kiện không mất khi broker chết, không xử lý hai lần, và không publish ngay trong request.',
      ['OutboxMessage ghi cùng transaction','Consumer chặn trùng bằng InboxMessage'],
      ['outbox','worker','Kafka → inbox'],
      'building-block/Sudoku.Messaging',
      'Sự kiện đến chậm tối đa một chu kỳ quét (2 giây); bù lại không mất khi broker chết.'],
    ['03','Hot path riêng','SignalR chỉ chạm Redis và RAM; database ghi một lần khi trận kết thúc.',
      ['Nước đi đi qua hub, không qua DB','Chốt trận mới ghi PostgreSQL + Kafka'],
      ['nước đi','MatchHub','Redis'],
      'Multiplayer.Api/Hubs/MatchHub.cs',
      'Redis là điểm chết của phòng đấu; bù lại mỗi nước đi không chạm database.']
  ];
  return h(Shell,{n:17,eb:'MỤC 8 · GHI CHÚ & BÀI HỌC',
    title:h('span',null,'Ba quyết định giữ hệ thống ',h('em',null,'nhất quán'))},
    div({className:'row c3 grow r',style:{'--i':2,alignItems:'stretch'}},...dec.map(([n,t,d,items,chain,ev,trade],i)=>
      div({className:'dec',key:i},span({className:'num'},n),h('h3',null,t),h('p',null,d),
        div({className:'ev'},span({className:'lbl'},'Bằng chứng'),h('code',null,ev)),
        div({className:'trade'},span({className:'lbl'},'Đánh đổi'),h('p',{className:'sm'},trade)),
        div({className:'chain'},...chain.flatMap((x,ci)=>ci?[h('i',{key:'i'+ci}),h('b',{key:'b'+ci},x)]:[h('b',{key:'b'+ci},x)])),
        h('ul',{className:'ticks'},...items.map((x,ki)=>h('li',{key:ki},x)))))),
    h(Strip,{k:'Điểm cộng'},'OpenTelemetry tracing, cache Redis cho nội dung và xUnit cho rule engine là ba phần mở rộng đã có chỗ cắm.')
  );
}

