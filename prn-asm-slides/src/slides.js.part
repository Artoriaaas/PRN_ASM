/* ---------------- bộ khung trình chiếu ---------------- */
const slides=[SlideCover,SlideToc,SlideScope,SlideArch,SlideLayers,SlideErd,SlideRest,SlideJobs,
  SlideKafka,SlideGrpc,SlideAuth,SlideSoloFlow,SlideMulti,SlideDeploy,SlideTech,SlideDeliverables,
  SlideDecisions,SlideEnd];
const slideTitles=['Bìa · Bàn cờ Sudoku, bốn service','Mục lục · bản đồ bài trình bày','Mục tiêu & phạm vi','Kiến trúc tổng thể (C4)',
  'Kiến trúc tầng & database','Sơ đồ thực thể (ERD)','REST API (Support)','Background job','Kafka & Outbox–Inbox','gRPC contract-first',
  'Xác thực JWT','Luồng solo end-to-end','Multiplayer realtime','Deploy bằng Docker Compose','Yêu cầu kỹ thuật',
  'Sản phẩm phải nộp','Ba quyết định thiết kế','Kết & Q&A'];
const NOTES=[
 'Chào thầy và các bạn. Nhóm em làm Sudoku Online: chơi đơn và đấu 1v1 thời gian thực. Bài hôm nay đi theo đúng cấu trúc của đề, mỗi mục chỉ vào một thành phần cụ thể trong hệ thống.',
 'Bài trình bày đi theo ba chặng: nền tảng và kiến trúc, bốn trụ công nghệ bắt buộc, rồi luồng chạy thật và phần nộp bài. Thang điểm in ở cuối tờ này — kiến trúc và REST API mỗi phần 20 điểm nên hai phần đó được nói kỹ nhất.',
 'Domain Sudoku được chọn vì nó có ba loại tải khác nhau: đọc nội dung nhiều, chơi đơn cần kiểm tra ở server, và đấu 1v1 cần độ trễ thấp. Mỗi loại ứng với một công nghệ trong đề.',
 'Toàn bộ hệ thống có một cửa vào là Envoy. Envoy làm ba việc: chuyển gRPC-Web sang gRPC, kiểm JWT, và nâng cấp WebSocket cho SignalR. Phía sau là bốn service, mỗi service một database.',
 'Mọi service theo cùng một khuôn: tầng API, tầng Domain, tầng Data. Quy ước quan trọng là Repository không tự SaveChanges, Domain service gom một lần qua UnitOfWork.',
 'Sơ đồ thực thể có 22 thực thể trên 25 bảng. Điểm cần nói là khoá ngoại chỉ tồn tại bên trong từng database: Level sinh ra Puzzle, Puzzle sinh ra GameSession, mỗi phiên có nhiều GameMove. Xuyên service chỉ có tham chiếu mềm bằng UserId, PuzzleId, MatchId.',
 'Phần nội dung đọc nhiều được tách thành REST: notices và tutorials có CRUD, tìm kiếm, lọc theo category hoặc difficulty, sắp xếp và phân trang. GET công khai, ghi dữ liệu cần JWT.',
 'Ba worker đang chạy: quét outbox mỗi 2 giây, bổ sung puzzle mỗi 60 giây để không cạn đề, và quét vòng đời trận 1v1 mỗi giây. Cả ba đều không chặn request của người chơi.',
 'Điểm chính của slide này: sự kiện được ghi vào outbox trong cùng transaction với dữ liệu, rồi worker mới đẩy lên Kafka. Phía nhận kiểm tra Inbox trước khi xử lý nên không bị cộng hai lần.',
 'Toàn bộ API viết bằng proto trước. Sinh mã C# cho server và TypeScript cho client. Multiplayer là service gRPC độc lập; Support gọi sang Game và User bằng gRPC client có deadline.',
 'Token Firebase được kiểm ngay ở Envoy bằng Google JWKS, nên service không phải gọi mạng mỗi request. Backend chỉ đọc claim sub làm UserId, không nhận userId từ body.',
 'Đây là luồng sẽ bấm khi demo: bắt đầu ván, đánh vài nước, nộp bài. Sau đó mở log để thấy outbox được gửi, Kafka nhận GameFinished và User Service cộng total_games.',
 'Multiplayer là phần nặng nhất về độ trễ. Nước đi chỉ đi qua hub và Redis, không ghi database. Khi trận kết thúc mới ghi PostgreSQL và phát MatchCompleted.',
 'Cả hệ thống chạy bằng một lệnh compose: mười container, gồm gateway, web, bốn service, PostgreSQL, Redis và Kafka. Cấu hình đọc từ .env, không hardcode secret.',
 'Bảng này là bản đối chiếu để trả lời câu hỏi: mỗi yêu cầu kỹ thuật của đề nằm ở đâu trong mã nguồn. Cột phải là đường dẫn hoặc thành phần có thể mở ra xem ngay.',
 'Sáu sản phẩm nộp đều nằm trong repo. Phần dễ mất điểm nhất là README và phân công, nên nhóm ghi rõ từng người phụ trách service nào.',
 'Ba quyết định giữ cho hệ thống nhất quán: hợp đồng viết trước, outbox/inbox cho sự kiện, và tách hot path realtime ra khỏi database.',
 'Cảm ơn thầy và các bạn. Nhóm em nhận câu hỏi, ưu tiên câu hỏi về kiến trúc và luồng sự kiện vì đó là phần nhóm đầu tư nhiều nhất.'
];

const uiIcon={left:'←',right:'→',full:'⤢',grid:'▦',help:'?',notes:'N'};
class Presentation extends R.Component{
  constructor(p){
    super(p);
    const hash=Number(location.hash.replace('#',''));
    this.state={index:Number.isFinite(hash)&&hash>=1&&hash<=TOTAL?hash-1:0,overview:false,help:false,notes:false,scale:1};
    this.touchStart=null;this.lastWheel=0;
    this.keyHandler=this.handleKey.bind(this);this.resizer=this.resize.bind(this);this.wheeler=this.wheel.bind(this);
  }
  componentDidMount(){
    window.addEventListener('keydown',this.keyHandler);
    window.addEventListener('resize',this.resizer);
    window.addEventListener('wheel',this.wheeler,{passive:false});
    this.hashHandler=()=>{const n=Number(location.hash.slice(1));if(n>=1&&n<=TOTAL)this.setState({index:n-1});};
    window.addEventListener('hashchange',this.hashHandler);
    this.resize();
  }
  componentWillUnmount(){
    window.removeEventListener('keydown',this.keyHandler);
    window.removeEventListener('resize',this.resizer);
    window.removeEventListener('wheel',this.wheeler);
    window.removeEventListener('hashchange',this.hashHandler);
  }
  resize(){this.setState({scale:Math.min(window.innerWidth/1600,window.innerHeight/900)});}
  go(delta){
    this.setState(s=>{
      const index=Math.max(0,Math.min(TOTAL-1,s.index+delta));
      if(index!==s.index)window.history.replaceState(null,'','#'+(index+1));
      return {index,overview:false,help:false};
    });
  }
  goto(index){window.history.replaceState(null,'','#'+(index+1));this.setState({index,overview:false,help:false});}
  theme(){
    const order=['giay','reu','cham'];
    const now=document.documentElement.dataset.look||'giay';
    const next=order[(order.indexOf(now)+1)%order.length];
    if(next==='giay')delete document.documentElement.dataset.look;else document.documentElement.dataset.look=next;
  }
  handleKey(e){
    const tag=document.activeElement?.tagName;
    if(tag==='INPUT'||tag==='TEXTAREA'||document.activeElement?.isContentEditable)return;
    const k=e.key;
    if(['ArrowRight','ArrowDown',' ','PageDown','Enter'].includes(k)){e.preventDefault();this.go(1);}
    else if(['ArrowLeft','ArrowUp','PageUp','Backspace'].includes(k)){e.preventDefault();this.go(-1);}
    else if(k==='Home')this.goto(0);
    else if(k==='End')this.goto(TOTAL-1);
    else if(k.toLowerCase()==='o')this.setState(s=>({overview:!s.overview,help:false}));
    else if(k.toLowerCase()==='n')this.setState(s=>({notes:!s.notes}));
    else if(k.toLowerCase()==='d')this.theme();
    else if(k.toLowerCase()==='f')this.fullscreen();
    else if(k==='?'||k.toLowerCase()==='h')this.setState(s=>({help:!s.help,overview:false}));
    else if(k==='Escape')this.setState({help:false,overview:false,notes:false});
  }
  wheel(e){
    if(Math.abs(e.deltaY)<18||this.state.overview)return;
    const t=Date.now();if(t-this.lastWheel<650)return;this.lastWheel=t;this.go(e.deltaY>0?1:-1);
  }
  fullscreen(){if(!document.fullscreenElement)document.documentElement.requestFullscreen?.();else document.exitFullscreen?.();}
  render(){
    const {index,scale,overview,help,notes}=this.state;
    const Active=slides[index];
    return div({className:'presentation-shell',
      onTouchStart:ev=>{this.touchStart={x:ev.touches[0].clientX,y:ev.touches[0].clientY};},
      onTouchEnd:ev=>{if(!this.touchStart)return;const dx=ev.changedTouches[0].clientX-this.touchStart.x;if(Math.abs(dx)>75)this.go(dx<0?1:-1);this.touchStart=null;}},
      div({className:'stage',style:{transform:`translate(-50%,-50%) scale(${scale})`}},
        div({className:'slide-canvas',key:index},h(Active,{}))),
      div({className:'app-topline'},span({className:'live-dot'}),span(null,'PRN ASM'),span({className:'app-divider'}),span(null,'Sudoku Online')),
      div({className:'app-bottom'},
        div({className:'nav-controls'},
          h('button',{className:'nav-btn',title:'Tờ trước (←)',onClick:()=>this.go(-1),disabled:index===0},uiIcon.left),
          h('button',{className:'nav-btn active-nav',title:'Tờ sau (→)',onClick:()=>this.go(1),disabled:index===TOTAL-1},uiIcon.right)),
        div({className:'progress-zone'},
          div({className:'progress-rail'},div({className:'progress-current',style:{width:(index+1)/TOTAL*100+'%'}})),
          span({className:'progress-numbers'},String(index+1).padStart(2,'0')+' / '+TOTAL)),
        div({className:'nav-tools'},
          h('button',{className:'tool-btn'+(notes?' selected':''),title:'Ghi chú người nói (N)',onClick:()=>this.setState({notes:!notes})},uiIcon.notes),
          h('button',{className:'tool-btn'+(overview?' selected':''),title:'Xem tất cả tờ (O)',onClick:()=>this.setState({overview:!overview,help:false})},uiIcon.grid),
          h('button',{className:'tool-btn'+(help?' selected':''),title:'Phím tắt (?)',onClick:()=>this.setState({help:!help,overview:false})},uiIcon.help),
          h('button',{className:'tool-btn',title:'Toàn màn hình (F)',onClick:()=>this.fullscreen()},uiIcon.full))),
      notes?div({className:'note-band'},h('b',null,'Ghi chú · tờ '+String(index+1).padStart(2,'0')),h('p',null,NOTES[index])):null,
      overview?div({className:'modal-backdrop',onClick:()=>this.setState({overview:false})},
        div({className:'overview-modal',onClick:ev=>ev.stopPropagation()},
          div({className:'modal-head'},h('b',null,'18 tờ · PRN ASM'),h('button',{onClick:()=>this.setState({overview:false})},'×')),
          div({className:'slide-picker'},...slideTitles.map((name,i)=>
            div({className:'slide-thumb'+(i===index?' current':''),key:i,onClick:()=>this.goto(i)},
              span({className:'thumb-n'},String(i+1).padStart(2,'0')),
              span({className:'thumb-name'},name),
              div({className:'thumb-bar'})))))):null,
      help?div({className:'modal-backdrop',onClick:()=>this.setState({help:false})},
        div({className:'help-modal',onClick:ev=>ev.stopPropagation()},
          div({className:'modal-head'},h('b',null,'Điều khiển trình chiếu'),h('button',{onClick:()=>this.setState({help:false})},'×')),
          div({className:'help-list'},...[['→ / Space','Tờ tiếp theo'],['← / Backspace','Tờ trước'],['Home / End','Đầu / cuối'],
            ['N','Ghi chú người nói'],['O','Xem tất cả 18 tờ'],['D','Đổi kiểu màu (giấy · rêu · chàm)'],
            ['F','Toàn màn hình'],['Esc','Đóng bảng này']].map(([k,v],i)=>
            div({className:'help-row',key:i},span({className:'keycap'},k),span(null,v)))))):null
    );
  }
}
RD.render(h(Presentation),document.getElementById('root'));
})();
