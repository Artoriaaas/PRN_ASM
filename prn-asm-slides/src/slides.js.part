/* ---------------- 09 · kafka ---------------- */
function SlideKafka(){
  return h(Shell,{n:9,eb:'MỤC 2.3 · MESSAGE BROKER',
    title:h('span',null,'Ghi outbox trong transaction, ',h('em',null,'Kafka chỉ là bước sau'))},
    h(Frame,{className:'grow r',style:{'--i':2},tag:'HÌNH 4',cap:'TRANSACTIONAL OUTBOX → KAFKA → IDEMPOTENT INBOX'},
      div({className:'pipe'},
        h(Node,{t:'Game / Multiplayer',s:'BEGIN TRANSACTION'}),
        h(Harrow),
        h(Node,{t:'OutboxMessage',s:'cùng transaction với dữ liệu'}),
        h(Harrow),
        h(Node,{t:'OutboxProcessorWorker',s:'mỗi 2 giây',tone:'son'}),
        h(Harrow),
        div({className:'topic',style:{flex:'1.25'}},h('b',null,'sudoku.events'),span(null,'APACHE KAFKA 3.9 · KRaft'),
          div({className:'evt',style:{marginTop:'6px'}},h('code',null,'GameFinished'),h('code',null,'MatchCompleted'))),
        h(Harrow),
        h(Node,{t:'User Service',s:'group user-service-events-consumer'}),
        h(Harrow),
        h(Node,{t:'InboxMessage',s:'chống xử lý lặp',tone:'si'})),
      div({className:'branch'},
        div({className:'panel'},span({className:'lbl'},'Producer'),h('p',{className:'sm'},'Game Service phát GameFinished khi người chơi nộp bài đúng. Multiplayer phát MatchCompleted khi trận kết thúc.')),
        div({className:'panel'},span({className:'lbl'},'Consumer'),h('p',{className:'sm'},'User Service cộng total_games và wins; mỗi sự kiện được kiểm tra InboxMessage trước khi xử lý.'))
      )),
    h(Strip,{k:'Vì sao',tone:'nghe'},'Không publish Kafka trong request: nếu broker chết, sự kiện vẫn nằm trong outbox và được gửi lại ở vòng quét sau.')
  );
}

