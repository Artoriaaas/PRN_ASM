/* ---------------- 05 · tầng ---------------- */
function SlideLayers(){
  const lay=[['API','GrpcService / Controller','nhận request, map Protobuf hoặc DTO'],[
    'DOMAIN','Domain service · rule policy','nghiệp vụ Sudoku, Elo, kiểm tra lời giải'],[
    'DATA','Repository · EF Core','truy vấn AsNoTracking, ghi qua UnitOfWork']];
  return h(Shell,{n:5,eb:'MỤC 2.1 · KIẾN TRÚC TẦNG',
    title:h('span',null,'Mỗi service ',h('em',null,'ba tầng'),', mỗi service một database')},
    div({className:'row r grow',style:{'--i':2,gridTemplateColumns:'1.15fr .85fr',gap:'40px'}},
      div({className:'layers'},
        ...lay.map(([k,b,s],i)=>div({className:'lay '+(i===0?'son':''),key:i},
          h('em',null,k),div(null,h('b',null,b),span(null,s)))),
        div({className:'lay'},h('em',null,'DB'),div({style:{background:'var(--vai)',color:'var(--on-vai)'}},h('b',null,'PostgreSQL 16'),span({style:{color:'var(--on-vai)',opacity:.7}},'database riêng của service')))
      ),
      div({className:'stack',style:{justifyContent:'center'}},
        div({className:'dbs'},...['game_db','user_db','multiplayer_db','support_db'].map((d,i)=>
          h(Node,{key:i,t:d,s:'chỉ service sở hữu truy cập'}))),
        h(Strip,{k:'Quy ước'},'Repository không gọi SaveChangesAsync; Domain service gom một lần qua IUnitOfWork.'),
        h(Strip,{k:'Đọc',tone:'son'},'Mọi query đọc dùng AsNoTracking + projection + Take(limit).')
      )
    )
  );
}

