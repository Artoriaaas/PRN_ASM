/* PRN ASM — 18 tờ trình chiếu theo rubric PRN232 Final Assignment.
   Nội dung: mục lục, mục tiêu, kiến trúc (C4 container) + ERD, REST API,
   background job, Kafka, gRPC, JWT, deploy Docker, yêu cầu kỹ thuật,
   sản phẩm nộp, ghi chú.
   Giao diện: "Bản vẽ kỹ thuật động" — giấy kẻ ô, mực cobalt, nhãn mono. */
(function(){
'use strict';
const R=window.React, RD=window.ReactDOM;
const h=R.createElement;
const TOTAL=18;
const div=(p,...c)=>h('div',p,...c);
const span=(p,...c)=>h('span',p,...c);

/* ---------------- khối dùng chung ---------------- */
function Frame(props){
  const {tag='HÌNH',cap='',children,style,className=''} = props;
  return h('figure',{className:'fig '+className,style},
    span({className:'tick tl'}),span({className:'tick tr'}),
    span({className:'tick bl'}),span({className:'tick br'}),
    div({className:'body'},children),
    h('figcaption',{className:'cap'},span(null,h('b',null,tag)),span(null,cap))
  );
}
const Node=(props)=>{
  const {t,s,tone='',style,children}=props;
  return div({className:'node '+tone,style},h('b',null,t),s?span(null,s):null,children||null);
};
const VLine=({label})=>div({className:'vline'},span(null,label||''));
const Harrow=()=>span({className:'harrow'},'→');
const Strip=({k,tone='',children})=>div({className:'strip '+tone},h('b',null,k),div(null,children));

function Thread({i}){
  return div({className:'thread'},...Array.from({length:TOTAL},(_,k)=>
    h('i',{key:k,className:(k<i?'done':k===i?'now':'')})));
}
function Shell({n,eb,title,children,note,className=''}){
  return div({className:'slide-inner '+className},
    div({className:'eb r'},h('i'),eb),
    h('h2',{className:'r',style:{'--i':1}},title),
    children,
    div({className:'pg'},String(n).padStart(2,'0'),h('small',null,' / '+TOTAL)),
    h(Thread,{i:n-1}),
    div({className:'foot'},
      h('b',null,'PRN232'),
      span({className:'dot'},'·'),
      span(null,note||'Sudoku Online · .NET 8'),
      span({style:{marginLeft:'auto'}},'PRN_ASM · Nhóm 4')
    )
  );
}

/* ---------------- dữ liệu ---------------- */
const MEMBERS=[['Nguyễn Duy Phong','SE192969'],['Phạm Gia Huy','SE192867'],['Mai Tuấn Vỹ','SE194261'],['Nguyễn Tuấn Kiệt','SE192837']];
const PUZZLE=[
 [5,3,0,0,7,0,0,0,0],[6,0,0,1,9,5,0,0,0],[0,9,8,0,0,0,0,6,0],
 [8,0,0,0,6,0,0,0,3],[4,0,0,8,0,3,0,0,1],[7,0,0,0,2,0,0,0,6],
 [0,6,0,0,0,0,2,8,0],[0,0,0,4,1,9,0,0,5],[0,0,0,0,8,0,0,7,9]
];
function Board(){
  return div({className:'sudoku'},...PUZZLE.flatMap((row,r)=>row.map((v,c)=>{
    const cls=[];
    if(c%3===2&&c<8)cls.push('bR');
    if(r%3===2&&r<8)cls.push('bB');
    if(v)cls.push('given');
    if(r===4&&c===4)cls.push('focus');
    return span({key:r*9+c,className:cls.join(' ')},v?String(v):'');
  })));
}
const WORKERS=[
 ['2 giây','OutboxProcessorWorker','Quét OutboxMessage chưa gửi, publish lên Kafka rồi đánh dấu đã xử lý.','Game.Api + Multiplayer.Api · Messaging/'],
 ['60 giây','PuzzleReplenishWorker','Giữ tối thiểu 15 puzzle chưa chơi cho mỗi cấp độ đang mở để không cạn đề.','Game.Api · khởi động chờ 10 giây'],
 ['1 giây','MatchLifecycleWorker','Quét phòng 1v1 đang chạy: hết giờ chuẩn bị, quá hạn, chốt trận và phát kết quả.','Multiplayer.Api · Redis runtime store']
];
const PROTOS=[
 ['game/v1/game.proto','Sinh đề · nước đi · điểm'],
 ['user/v1/user.proto','Hồ sơ · thống kê'],
 ['multi/v1/multi.proto','Ghép trận · Elo'],
 ['support/v1/support.proto','Luật chơi · hướng dẫn'],
 ['events/v1/events.proto','GameFinished · MatchCompleted']
];
const STEPS=[
 ['01','StartGame','gRPC qua Envoy, chọn cấp độ, nhận puzzle','hot'],
 ['02','Phiên chơi','EF Core ghi game_db, giữ thời gian và lỗi',''],
 ['03','SubmitResult','Kiểm tra lời giải ở server, tính điểm',''],
 ['04','GameFinished','Ghi OutboxMessage cùng transaction',''],
 ['05','Kafka','Worker phát vào sudoku.events',''],
 ['06','User Service','Consumer cộng total_games, wins','']
];
const COMPOSE=[
 ['Lớp biên',[
   ['gateway','Envoy 8080 · host 18080','son'],['web','Nginx + React build','']]],
 ['Ứng dụng',[
   ['game-service','gRPC 8080',''],['user-service','gRPC 8080',''],
   ['multiplayer-service','gRPC 8080 · WS 8081',''],['support-service','HTTP 8080','']]],
 ['Hạ tầng',[
   ['postgres','PostgreSQL 16','flat'],['redis','Redis 7','flat'],['kafka','Apache Kafka 3.9','flat']]]
];
const MATRIX=[
 ['.NET 8 / ASP.NET Core','4 service trong services/'],
 ['Entity Framework Core','GameDbContext · migrations'],
 ['CSDL quan hệ','PostgreSQL 16 · 4 database'],
 ['Dependency Injection','AddScoped / AddSingleton'],
 ['Configuration','appsettings + env · Services:*'],
 ['Logging & exception','ILogger · RpcException chuẩn'],
 ['JWT Authentication','Sudoku.Auth · Envoy JWKS'],
 ['RESTful API design','Support.Api /api/v1'],
 ['gRPC communication','proto/sudoku/*/v1'],
 ['Message Broker','Kafka + Outbox/Inbox'],
 ['Background Service','3 worker · 3 chu kỳ'],
 ['Docker containerization','Dockerfile + docker-compose']
];
const DELIV=[
 ['Mã nguồn','Toàn bộ solution .NET 8 và React SPA','services/ · clients/ · building-block/'],
 ['Migration','Mỗi service có DbContext và migration riêng','Data/Migrations/*'],
 ['Dockerfile','Bốn service, gateway và web đều có Dockerfile','services/*/Dockerfile'],
 ['Docker Compose','Mười container chạy bằng một lệnh','deploy/docker-compose.yml'],
 ['API documentation','Swagger cho REST, .proto cho gRPC','/swagger · proto/sudoku'],
 ['README','Kiến trúc, cài đặt, deploy và phân công','README.md · README_VI.md']
];
const TOC=[
 ['03','Mục tiêu & phạm vi','Solo · 1v1 · nội dung đọc'],
 ['04','Kiến trúc tổng thể','Container diagram C4 · bốn service'],
 ['05','Kiến trúc tầng & database','API · Domain · Data · UnitOfWork'],
 ['06','Sơ đồ thực thể (ERD)','22 thực thể · khoá ngoại trong từng DB'],
 ['07','REST API','Support: CRUD, tìm kiếm, phân trang'],
 ['08','Background job','Ba worker, ba chu kỳ quét'],
 ['09','Kafka & Outbox–Inbox','Một topic, không mất sự kiện'],
 ['10','gRPC contract-first','Năm hợp đồng .proto sinh mã'],
 ['11','Xác thực JWT','Envoy kiểm Firebase JWKS'],
 ['12','Luồng solo end-to-end','Sáu bước, một transaction'],
 ['13','Multiplayer realtime','SignalR + Redis cho hot path'],
 ['14','Deploy Docker Compose','Mười container, một lệnh'],
 ['15','Yêu cầu kỹ thuật','Bảng đối chiếu mười hai dòng'],
 ['16','Sản phẩm phải nộp','Sáu danh mục trong repo'],
 ['17','Ba quyết định thiết kế','Đánh đổi đi kèm bằng chứng'],
 ['18','Kết & hỏi đáp','Repo, demo và câu hỏi']
];
const WEIGHTS=[
 ['20','Kiến trúc'],['20','REST API'],['15','Message broker'],['15','gRPC'],
 ['10','Background job'],['10','Docker'],['10','Tài liệu']
];

/* ---------------- 01 · bìa ---------------- */
function SlideCover(){
  return div({className:'slide-inner'},
    div({className:'eb r'},h('i'),'PRN232 · FINAL ASSIGNMENT · HỆ PHÂN TÁN VỚI .NET'),
    div({className:'cover'},
      div({className:'cover-copy'},
        h('h1',{className:'r',style:{'--i':1}},'Bàn cờ Sudoku,',h('br'),h('em',null,'bốn service'),h('br'),'và một dòng sự kiện'),
        h('p',{className:'cover-sub r',style:{'--i':2}},'Xây dựng ứng dụng phân tán bằng .NET 8 — REST API, background job, Apache Kafka, gRPC và Docker Compose — minh hoạ trên một game Sudoku có chế độ 1v1 thời gian thực.'),
        div({className:'cover-meta r',style:{'--i':3}},
          h('b',null,'Nhóm'),span(null,'PRN_ASM · Sudoku Online Platform'),
          h('b',null,'Học phần'),span(null,'PRN232 · Final Assignment'),
          h('b',null,'Ngày'),span(null,'Tháng 11 · 2026'),
          h('b',null,'Thành viên'),div({className:'mem'},...MEMBERS.map(([name,id],k)=>
            h('i',{key:k},name,h('small',null,id))))
        )
      ),
      h(Frame,{className:'cover-fig',tag:'HÌNH 1',cap:'BÀN CỜ 9×9 · 81 Ô · 27 RÀNG BUỘC'},
        div({className:'body'},div({style:{width:'420px'}},h(Board))),
        div({className:'dim'},'HÀNG 9 · CỘT 9 · KHỐI 3×3'),
        div({className:'dim'},'PUZZLE BANK ≥ 15 / CẤP ĐỘ')
      )
    )
  );
}

/* ---------------- 02 · mục lục ---------------- */
function SlideToc(){
  return h(Shell,{n:2,eb:'MỤC LỤC · BẢN ĐỒ BÀI TRÌNH BÀY',
    title:h('span',null,'Từ bài toán đến ',h('em',null,'bàn cờ chạy thật'))},
    div({className:'toc r',style:{'--i':2}},...[0,6,11].map(start=>
      div({className:'toc-col',key:start},...TOC.slice(start,start+(start===0?6:5)).map(([n,t,d],i)=>
        div({className:'toc-item',key:i},
          h('em',null,n),h('b',null,t),span(null,d)))))),
    div({className:'weights r',style:{'--i':3}},
      span({className:'k'},'Thang điểm'),
      ...WEIGHTS.map(([w,l],i)=>span({className:'w',key:i},h('b',null,w+'%'),span(null,l)))),
    h(Strip,{k:'Cách đọc',tone:'nghe'},'Mười sáu tờ nội dung đi theo thứ tự trình bày; tờ 15 đối chiếu mười hai yêu cầu kỹ thuật, tờ 16 là danh mục sản phẩm.')
  );
}

/* ---------------- 03 · phạm vi ---------------- */
function SlideScope(){
  const cards=[
    ['SOLO','01','Chơi đơn theo bốn cấp độ: sinh đề, kiểm tra nước đi, gợi ý, tính điểm và lưu phiên.','gRPC + PostgreSQL',
      ['Ngân hàng đề giữ tối thiểu 15 puzzle mỗi cấp','Server kiểm lời giải, không tin client','Lưu phiên và nước đi vào game_db']],
    ['1V1','02','Đối kháng thời gian thực: ghép trận theo Elo, đồng bộ từng nước, chốt kết quả sau ván.','SignalR + Redis',
      ['Ghép trận theo Elo, hai thể thức Race và Duel','Nước đi qua MatchHub, trạng thái phòng trong Redis','Chốt trận mới ghi PostgreSQL và phát MatchCompleted']],
    ['NỘI DUNG','03','Luật chơi, bài hướng dẫn, thông báo hệ thống: đọc nhiều nên tách thành REST.','REST API + Redis cache',
      ['CRUD notices và tutorials có tìm kiếm, lọc','Phân trang, sắp xếp, cache Redis cho bài đọc','Portal game-overview tổng hợp số liệu qua gRPC']]
  ];
  return h(Shell,{n:3,eb:'MỤC 1–2 · MỤC TIÊU & PHẠM VI',
    title:h('span',null,'Domain nhỏ, nhưng ',h('em',null,'đủ chỗ'),' cho cả bốn công nghệ')},
    div({className:'row c3 grow r',style:{'--i':2}},...cards.map(([k,n,t,tech,items],idx)=>
      div({className:'panel',key:idx},
        span({className:'lbl'},k+' · '+n),
        h('h3',null,idx===0?'Chơi đơn có kiểm soát':idx===1?'Hai người, một bàn cờ':'Nội dung tĩnh, đọc nhiều'),
        h('p',{className:'sm'},t),
        h('ul',{className:'ticks'},...items.map((x,ki)=>h('li',{key:ki},x))),
        span({className:'mono lbl',style:{color:'var(--son)'}},tech)
      ))),
    h(Strip,{k:'Ràng buộc đề'},'Tối thiểu: một REST API, một background job, một producer và một consumer, một service gRPC độc lập, toàn bộ chạy bằng Docker Compose.')
  );
}

