        div({className:'q'},...['search','category','difficulty','isPublished','sortBy','sortDir','page','pageSize'].map((q,i)=>h('code',{key:i},q))),
        div({className:'kv',style:{marginTop:'10px'}},
          span(null,'Phản hồi'),h('b',null,'PagedResponse'),
          span(null,'Mặc định'),h('b',null,'10 / trang'),
          span(null,'Ghi dữ liệu'),h('b',null,'[Authorize]'),
          span(null,'Tài liệu'),h('b',null,'/swagger')),
        h(Strip,{k:'Lỗi'},'Domain exception → ProblemDetails 400/404; thiếu token → 401 từ Envoy.')
      )
    )
  );
}

/* ---------------- 08 · background job ---------------- */
function SlideJobs(){
  return h(Shell,{n:8,eb:'MỤC 2.2 · BACKGROUND JOB',
