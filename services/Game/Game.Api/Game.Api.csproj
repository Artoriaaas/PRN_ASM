<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <Protobuf Include="../../../proto/sudoku/game/v1/game.proto" ProtoRoot="../../../proto" GrpcServices="Server" />
    <Protobuf Include="../../../proto/sudoku/user/v1/user.proto" ProtoRoot="../../../proto" GrpcServices="Client" />
    <Protobuf Include="../../../proto/sudoku/events/v1/events.proto" ProtoRoot="../../../proto" GrpcServices="None" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Grpc.AspNetCore" Version="2.57.0" />
    <PackageReference Include="Grpc.AspNetCore.HealthChecks" Version="2.57.0" />
    <PackageReference Include="Grpc.Net.ClientFactory" Version="2.57.0" />
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="8.0.11" />
    <PackageReference Include="EFCore.NamingConventions" Version="8.0.3" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="8.0.11">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\..\building-block\Sudoku.Auth\Sudoku.Auth.csproj" />
    <ProjectReference Include="..\..\..\building-block\Sudoku.Observability\Sudoku.Observability.csproj" />
    <ProjectReference Include="..\..\..\building-block\Sudoku.Messaging\Sudoku.Messaging.csproj" />
    <ProjectReference Include="..\..\..\building-block\Sudoku.Core\Sudoku.Core.csproj" />
  </ItemGroup>

</Project>
