# Backend base URL khi build (dùng cho `vite dev` / Vercel / CI).
# Để trống = same-origin (web nginx proxy tới Envoy).
# Runtime override không cần build lại: mở app với ?api=https://xxx.trycloudflare.com
VITE_API_URL=http://localhost:8080

# Dev JWT (HS256) — CHỈ dùng cho local/demo.
# - Bỏ trống ⇒ build production không gửi dev token (chỉ Firebase ID token hợp lệ).
# - Đặt >= 32 ký tự ⇒ FE tự ký được token guest/dev-admin. Giá trị phải TRÙNG
#   `Auth:DevSecret` của backend (`DEV_AUTH_SECRET` trong deploy/.env).
VITE_DEV_AUTH_SECRET=

# mock (mặc định, không cần backend cho notification/invite) | api
VITE_NOTIFICATIONS_MODE=mock

VITE_FIREBASE_API_KEY=AIzaSyDLQdj7QKdTpaxX4DDpt8-kYS0Uyg7SNuo
VITE_FIREBASE_AUTH_DOMAIN=prn222-469cc.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=prn222-469cc
VITE_FIREBASE_STORAGE_BUCKET=prn222-469cc.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=343239229700
VITE_FIREBASE_APP_ID=1:343239229700:web:ebf7a924aa535ef6da1051
VITE_FIREBASE_MEASUREMENT_ID=G-JPB23F9R4S
