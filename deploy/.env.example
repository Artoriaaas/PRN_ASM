# Ports
GATEWAY_PORT=18080
WEB_PORT=5173

# Database
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

# Firebase
FIREBASE_PROJECT_ID=prn222-469cc

# Dev JWT (chỉ cho local/demo).
#  - ALLOW_DEV_TOKENS: true = backend chấp nhận token HS256 do FE tự ký (không cần Firebase).
#    Đặt false để chỉ chấp nhận Firebase ID token thật.
#  - DEV_AUTH_SECRET: phải TRÙNG với VITE_DEV_AUTH_SECRET khi build FE (>= 32 ký tự).
ALLOW_DEV_TOKENS=true
DEV_AUTH_SECRET=sudoku-platform-insecure-dev-jwt-secret-key-2026-minimum-32-chars!
